{
  "name": "codex-minus",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/desktop-dev.mjs",
    "build": "node scripts/desktop-package.mjs",
    "core:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "core:release": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "desktop:start": "electron .",
    "desktop:test": "node --test desktop/*.test.mjs scripts/*.test.mjs",
    "update:smoke:mac": "node scripts/update-macos-smoke.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "knip": "knip",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "verify": "npm run check && npm test && npm run desktop:test && npm run knip",
    "vite:dev": "vite --host 127.0.0.1 --port 1420",
    "vite:build": "vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "5.3.0",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "knip": "^6.32.2",
    "tailwindcss": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
